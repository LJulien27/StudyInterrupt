{
    "manifest_version": 3,
    "name": "Study Break",
    "version": "1.0",
    "description": "Opens Study Break after specified timer so you can be interrupted to study.",
    "action": {
        "default_popup": "js/index.html",
        "default_title": "Study Break",
        "default_icon": {
            "16": "icons/study-online16.png",
            "48": "icons/study-online48.png",
            "128": "icons/study-online128.png"
        }
    },
    "icons": {
        "16": "icons/study-online16.png",
        "48": "icons/study-online48.png",
        "128": "icons/study-online128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["tabs"]
}
