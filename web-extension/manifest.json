{
    "manifest_version": 3,
    "name": "Tab Watcher",
    "version": "1.0",
    "description": "Opens Apple 5 seconds after switching tabs.",
    "action": {
        "default_popup": "js/index.html",
        "default_title": "React Chrome Extension"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["tabs"]
}
